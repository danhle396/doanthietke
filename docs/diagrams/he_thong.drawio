ng chạy,&lt;br&gt;dừng ở lệnh sai đầu tiên (kiểm bằng RTL có lỗi cài sẵn)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;arcSize=8;fontColor=#000000;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1200" y="575" width="380" height="85" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="4. Luồng build và regression"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="760" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Luồng build, kiểm chứng và đánh giá&lt;/b&gt; (Makefile → scripts/*.py)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#000000;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="30" as="geometry" /></mxCell><mxCell id="env" value="&lt;b&gt;make check-env&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Verilator, Yosys, GCC,&lt;br&gt;Spike, nextpnr&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;arcSize=8;fontColor=#000000;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="170" height="70" as="geometry" /></mxCell><mxCell id="fetch" value="&lt;b&gt;make fetch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;riscv-tests, CoreMark&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;arcSize=8;fontColor=#000000;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="170" height="70" as="geometry" /></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;jumpStyle=arc;jumpSize=8;labelBackgroundColor=#ffffff