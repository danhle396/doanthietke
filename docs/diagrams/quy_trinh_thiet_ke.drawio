<mxfile host="drawio" version="24.7.17"><diagram id="p1" name="1. Quy trình thiết kế"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1380" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Quy trình thiết kế SoC RISC-V RV32IMC (từ đặc tả đến FPGA / ASIC)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1050" height="34" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Đề tài + đề cương chi tiết&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="60" width="240" height="50" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;1. Đặc tả yêu cầu&lt;/b&gt;&lt;br&gt;PROJECT_SPEC.md → docs/spec.md,&lt;br&gt;memory_map.md, register_map.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="380" height="70" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;2. Thiết kế kiến trúc / vi kiến trúc&lt;/b&gt;&lt;br&gt;sơ đồ SoC, pipeline 5 tầng, bus Wishbone / APB&lt;br&gt;docs/microarch.md, docs/decisions.md" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="240" width="380" height="70" as="geometry"/></mxCell><mxCell id="n5" value='&lt;b&gt;3. Mô tả RTL bằng SystemVerilog&lt;/b&gt;&lt;br&gt;tăng dần: rv_core_sc → pipeline RV32I → M, C&lt;br&gt;→ BHT / BTB → CSR, trap → bus, UART, SPI, … → soc_top&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;i&gt;&lt;font color="#555555"&gt;Công cụ: VS Code&lt;/font&gt;&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="340" width="380" height="85" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;4. Lint + kiểm tra tổng hợp được&lt;/b&gt;&lt;br&gt;verilator --lint-only -Wall · yosys read_verilog -sv&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;i&gt;&lt;font color="#555555"&gt;Công cụ: Verilator, Yosys&lt;/font&gt;&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="455" width="380" height="65" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;5. Xác minh chức năng (make regress)&lt;/b&gt;&lt;br&gt;unit testbench · riscv-tests (ma trận cấu hình)&lt;br&gt;so sánh với Spike · co-simulation C++ lock-step&lt;br&gt;system test + BFM · coverage&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;i&gt;&lt;font color="#555555"&gt;Công cụ: Verilator, RISC-V GCC, Spike, Python&lt;/font&gt;&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="550" width="380" height="100" as="geometry"/></mxCell><mxCell id="n8" value="Tất cả&lt;br&gt;PASS?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="445" y="680" width="150" height="80" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;6. Đánh giá hiệu năng (make perf)&lt;/b&gt;&lt;br&gt;CPI theo BP_MODE, quét BHT × BTB,&lt;br&gt;hiệu quả extension C, Dhrystone, CoreMark" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="790" width="380" height="70" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;7. Tổng hợp logic + timing (make synth)&lt;/b&gt;&lt;br&gt;Yosys: số cell, diện tích&lt;br&gt;nextpnr-ecp5: Fmax, đường găng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="890" width="380" height="70" as="geometry"/></mxCell><mxCell id="n11" value="Đạt timing /&lt;br&gt;diện tích?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="445" y="990" width="150" height="80" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;8a. FPGA – board DE2 (make fpga)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;Quartus II 13.0sp1, Cyclone II EP2C35&lt;br&gt;Synthesis → Fitter → TimeQuest&lt;br&gt;→ nạp .sof qua USB-Blaster&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="290" y="1110" width="220" height="90" as="geometry"/></mxCell><mxCell id="n13" value='&lt;b&gt;8b. Layout ASIC (make asic)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;OpenLane 2 / sky130A&lt;br&gt;place &amp;amp; route, STA, DRC / LVS&lt;br&gt;mô phỏng gate-level ≡ RTL&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="1110" width="220" height="90" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;9. Tổng hợp kết quả + tài liệu (make docs)&lt;/b&gt;&lt;br&gt;results/*, docs/results.md, compliance.md&lt;br&gt;báo cáo 5 chương" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="1230" width="380" height="70" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Nghiệm thu / bảo vệ&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="1320" width="240" height="45" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value='&lt;b&gt;Gỡ lỗi&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;xem waveform (VCD / GTKWave), commit log&lt;br&gt;viết test tái hiện nhỏ nhất&lt;br&gt;sửa RTL / phần mềm&lt;br&gt;thêm test đó vào regression&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="545" width="240" height="110" as="geometry"/></mxCell><mxCell id="n27" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="720"/></Array></mxGeometry></mxCell><mxCell id="n28" value="lặp lại" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.4941;entryDx=0;entryDy=0;" edge="1" parent="1" source="n26" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="382"/></Array></mxGeometry></mxCell><mxCell id="n29" value="Không: tối ưu vi kiến trúc / RTL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="1030"/><mxPoint x="1070" y="275"/></Array></mxGeometry></mxCell><mxCell id="n30" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="1090"/><mxPoint x="400" y="1090"/></Array></mxGeometry></mxCell><mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="1090"/><mxPoint x="640" y="1090"/></Array></mxGeometry></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.1842;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.8158;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="&lt;b&gt;Phase 0&lt;/b&gt;&lt;br&gt;môi trường, khung repo,&lt;br&gt;đặc tả, memory / register map" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="240" height="70" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;Phase 1 → 7 (phát triển tăng dần)&lt;/b&gt;&lt;br&gt;&lt;br&gt;mỗi Phase thêm một nhóm tính năng:&lt;br&gt;1 single-cycle · 2 pipeline · 3 M, C&lt;br&gt;4 dự đoán rẽ nhánh · 5 CSR, trap, bus&lt;br&gt;6 UART, SPI, TIMER, GPIO · 7 soc_top&lt;br&gt;&lt;br&gt;xong mỗi Phase: chạy lại &lt;b&gt;toàn bộ&lt;/b&gt;&lt;br&gt;regression rồi mới commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="240" height="420" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Phase 7&lt;/b&gt;&lt;br&gt;hiệu năng, tổng hợp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="240" height="170" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Mở rộng&lt;/b&gt;&lt;br&gt;FPGA DE2, ASIC sky130" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="230" height="90" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;Phase 8&lt;/b&gt;&lt;br&gt;tài liệu, báo cáo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="240" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="2. Luồng xác minh"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Luồng xác minh chức năng – make regress" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1100" height="34" as="geometry"/></mxCell><mxCell id="n2" value='&lt;b&gt;Phần mềm&lt;/b&gt; (sw/)&lt;br&gt;&lt;font style="font-size:10px"&gt;crt0, trap, driver, system test,&lt;br&gt;benchmark, Dhrystone, CoreMark&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="220" height="70" as="geometry"/></mxCell><mxCell id="n3" value='&lt;b&gt;riscv-tests&lt;/b&gt; (third_party)&lt;br&gt;&lt;font style="font-size:10px"&gt;rv32ui / um / uc / mi&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="150" width="220" height="50" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;RTL&lt;/b&gt; (rtl/, rtl_files.f)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="220" height="55" as="geometry"/></mxCell><mxCell id="n5" value='&lt;b&gt;BFM&lt;/b&gt; (tb/bfm)&lt;br&gt;&lt;font style="font-size:10px"&gt;UART, SPI flash, SPI slave&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="220" height="60" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;14 unit testbench&lt;/b&gt; (tb/unit)&lt;br&gt;&lt;font style="font-size:10px"&gt;tự kiểm tra: PASS / FAIL&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="510" width="220" height="55" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;RISC-V GCC&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;rv32i / rv32im / rv32imc, ilp32&lt;/font&gt;&lt;br&gt;→ ELF' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="220" height="80" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;elf2hex.py&lt;/b&gt; → .hex" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="200" width="220" height="45" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;Lint&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;verilator --lint-only -Wall&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="220" height="55" as="geometry"/></mxCell><mxCell id="n10" value='&lt;b&gt;Spike&lt;/b&gt; --log-commits&lt;br&gt;&lt;font style="font-size:10px"&gt;mô hình tham chiếu ISA&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="60" width="260" height="55" as="geometry"/></mxCell><mxCell id="n11" value='&lt;b&gt;Mô phỏng Verilator&lt;/b&gt;&lt;br&gt;tb_soc + soc_top&lt;br&gt;&lt;font style="font-size:10px"&gt;--binary --timing&lt;br&gt;ma trận ENABLE_M × ENABLE_C × BP_MODE&lt;br&gt;kiểm tra giao thức Wishbone&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="180" width="260" height="210" as="geometry"/></mxCell><mxCell id="n12" value='&lt;b&gt;Verilator&lt;/b&gt;: chạy từng unit TB&lt;br&gt;&lt;font style="font-size:10px"&gt;PASS khi exit code = 0 và có chữ PASS&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="510" width="260" height="55" as="geometry"/></mxCell><mxCell id="n13" value="Đầu ra và so sánh" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=2;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;swimlaneFillColor=#FCFCFC;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="40" width="290" height="450" as="geometry"/></mxCell><mxCell id="n14" value='&lt;b&gt;compare_spike.py&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;so sánh từng lệnh đã commit&lt;/font&gt;' style="rounded=1;white