n6" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="IRQ_EN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#333333;exitX=1.0000;exitY=0.8333;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#b85450;dashed=1;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="spi_apb – SPI master (APB slot 1, 0x1000_1000)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=2;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;swimlaneFillColor=#FCFCFC;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="1090" height="360" as="geometry"/></mxCell><mxCell id="n22" value='&lt;b&gt;Giao tiếp APB4&lt;/b&gt;&lt;br&gt;+ thanh ghi&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;0x00 DATA&lt;br&gt;0x04 STATUS&lt;br&gt;0x08 CTRL (EN, CPOL,&lt;br&gt;CPHA, LSB_FIRST)&lt;br&gt;0x0C CLK_DIV&lt;br&gt;0x10 CS&lt;br&gt;0x14 IRQ_EN&lt;br&gt;0x18 IRQ_STATUS&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="n21"><mxGeometry x="20" y="45" width="190" height="290" as="geometry"/></mxCell><mxCell id="n23" value='&lt;b&gt;TX FIFO&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;sync_fifo 16 × 8 bit&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;" vertex="1" parent="n21"><mxGeometry x="270" y="55" width="170" height="60" as="geometry"/></mxCell><mxCell id="n24" value='&lt;b&gt;RX FIFO&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;sync_fifo 16 × 8 bit&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;" vertex="1" parent="n21"><mxGeometry x="270" y="155" width="170" height="60" as="geometry"/></mxCell><mxCell id="n25" value='&lt;b&gt;spi_master&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;FSM IDLE → XFER → GAP&lt;br&gt;f_SCLK = f_clk / (2 × (DIV + 1))&lt;br&gt;mode 0–3 (CPOL, CPHA)&lt;br&gt;MSB hoặc LSB trước&lt;br&gt;dịch song công 8 bit&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="n21"><mxGeometry x="510" y="55" width="220" height="160" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Thanh ghi CS&lt;/b&gt; → CS_N[3:0]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="n21"><mxGeometry x="510" y="235" width="220" height="40" as="geometry"/></mxCell><mxCell id="n27" value='&lt;b&gt;Logic ngắt&lt;/b&gt; &lt;font style="font-size:10px"&gt;TX_EMPTY · RX_NOT_EMPTY · DONE · OVERRUN&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;" vertex="1" parent="n21"><mxGeometry x="270" y="290" width="460" height="40" as="geometry"/></mxCell><mxCell id="n28" value="spi_sclk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="1160" y="495" width="110" height="30" as="geometry"/></mxCell><mxCell id="n29" value="spi_mosi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;f