ight="70" as="geometry"/></mxCell><mxCell id="n7" value="CLOCK_50" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="125" width="140" height="40" as="geometry"/></mxCell><mxCell id="n8" value="KEY[0] (reset)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="140" height="40" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="clk 24 MHz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.1061;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n12" value="locked" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value="rst_n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.4394;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value='&lt;b&gt;Cổng RS-232 (DB9)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;→ PC: PuTTY / Tera Term, 115200 8N1&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="1060" y="110.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n16" value="UART_TXD / RXD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;startArrow=block;startFill=1;exitX=1.0000;exitY=0.0909;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value='&lt;b&gt;JP1 – GPIO_0[6:0]&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;SCLK, MOSI, MISO, CS0_n…CS3_n&lt;br&gt;→ flash SPI W25Qxx (tùy chọn)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="1060" y="200.0" width="240" height="60" as="geometry"/></mxCell><mxCell id="n18" value="spi_*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;startArrow=block;startFill=1;exitX=1.0000;exitY=0.3636;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="&lt;b&gt;SW[15:0]&lt;/b&gt; → gpio_i" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="1060" y="295.0" width="240" height="40" as="geometry"/></mxCell><mxCell id="n20" value="gpio_i" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.6212;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="&lt;b&gt;LEDR[15:0]&lt;/b&gt; ← gpio_o &amp;amp; gpio_oe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="1060" y="375.0" width="240" height="40" as="geometry"/></mxCell><mxCell id="n22" value="gpio_o" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;exitX=1.0000;exitY=0.8636;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value='&lt;b&gt;PC – Quartus II 13.0sp1&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;compile de2_soc.qpf → de2_soc.sof&lt;br&gt;Programmer: USB-Blaster (JTAG)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520" y="640" width="290" height="70" as="geometry"/></mxCell><mxCell id="n24" value="nạp cấu hình (.sof)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5724;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5. Bản đồ bộ nhớ"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Bản đồ bộ nhớ (docs/memory_map.md)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="900" height="34" as="geometry"/></mxCell><mxCell id="n2" value="0x8002_0000 – 0xFFFF_FFFF · không ánh xạ → ERR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="70" width="380" height="40" as="geometry"/></mxCell><mxCell id="n3" value='&lt;b&gt;RAM 128 KB&lt;/b&gt; (ram_dp) · 0x8000_0000 – 0x8001_FFFF&lt;br&gt;&lt;font style="font-size:10px"&gt;.text (_start, reset PC = 0x8000_0000) · .rodata · .tohost&lt;br&gt;.data · .bss · stack 8 KB ở đỉnh (_stack_top = 0x8002_0000)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="380" height="120" as="geometry"/></mxCell><mxCell id="n4" value="0x1001_0000 – 0x7FFF_FFFF · không ánh xạ → ERR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="230" width="380" height="40" as="geometry"/></mxCell><mxCell id="n5" value="slot 15 · 0x1000_F000 · &lt;b&gt;SIM_CTRL&lt;/b&gt; (mô phỏng)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="270" width="380" height="36" as="geometry"/></mxCell><mxCell id="n6" value='slot 5 – 14 · 0x1000_5000 – 0x1000_EFFF&lt;br&gt;&lt;font style="font-size:10px"&gt;không có slave → PSLVERR → access fault&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="306" width="380" height="50" as="geometry"/></mxCell><mxCell id="n7" value="slot 4 · 0x1000_4000 · &lt;b&gt;INTC&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="356" width="380" height="36" as="geometry"/></mxCell><mxCell id="n8" value="slot 3 · 0x1000_3000 · &lt;b&gt;GPIO&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="392" width="380" height="36" as="geometry"/></mxCell><mxCell id="n9" value="slot 2 · 0x1000_2000 · &lt;b&gt;TIMER64&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="428" width="380" height="36" as="geometry"/></mxCell><mxCell id="n10" value="slot 1 · 0x1000_1000 · &lt;b&gt;SPI master&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="464" width="380" height="36" as="geometry"/></mxCell><mxCell id="n11" value="slot 0 · 0x1000_0000 · &lt;b&gt;UART&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="500" width="380" height="36" as="geometry"/></mxCell><mxCell id="n12" value="0x0000_0000 – 0x0FFF_FFFF · không ánh xạ → ERR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="536" width="380" height="40" as="geometry"/></mxCell><mxCell id="n13" value="APB4 qua apb_bridge&lt;br&gt;0x1000_0000 – 0x1000_FFFF&lt;br&gt;slot = addr[15:12], 4 KB / slot" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="270" width="170" height="266" as="geometry"/></mxCell><mxCell id="n14" value="Wishbone, ACK cùng chu kỳ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="110" width="170" height="120" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Giải mã&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;ibus&lt;/b&gt; (lệnh): chỉ RAM; địa chỉ ngoài RAM → ERR → instruction access fault (mcause 1)&lt;br&gt;&lt;br&gt;• &lt;b&gt;dbus&lt;/b&gt; qua dbus_xbar:&lt;br&gt;&amp;nbsp;&amp;nbsp;– RAM → ACK ngay trong chu kỳ yêu cầu&lt;br&gt;&amp;nbsp;&amp;nbsp;– 0x1000_xxxx → apb_bridge, tối thiểu 3 chu kỳ (IDLE → SETUP → ACCESS)&lt;br&gt;&amp;nbsp;&amp;nbsp;– còn lại → ERR → load / store access fault (mcause 5 / 7)&lt;br&gt;&lt;br&gt;• RAM đặt tại 0x8000_0000 để khớp mặc định của Spike và riscv-tests" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="400" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
