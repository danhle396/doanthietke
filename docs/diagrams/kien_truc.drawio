ry"/></mxCell><mxCell id="n58" value="&lt;b&gt;forward_unit&lt;/b&gt; – chọn toán hạng: ex_mem (trừ load / CSR) &amp;gt; mem_wb &amp;gt; regfile&lt;br&gt;phụ thuộc load-use liền kề → stall 1 chu kỳ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="650" y="705" width="608" height="60" as="geometry"/></mxCell><mxCell id="n59" value='&lt;font color="#333333"&gt;&lt;b&gt;━━&lt;/b&gt;&lt;/font&gt; dữ liệu &amp;nbsp;&amp;nbsp; &lt;font color="#b85450"&gt;&lt;b&gt;━━&lt;/b&gt;&lt;/font&gt; đổi hướng PC (redirect / flush) &amp;nbsp;&amp;nbsp; &lt;font color="#82b366"&gt;&lt;b&gt;┅┅&lt;/b&gt;&lt;/font&gt; forwarding &amp;nbsp;&amp;nbsp; &lt;font color="#82b366"&gt;&lt;b&gt;━━&lt;/b&gt;&lt;/font&gt; write-back &amp;nbsp;&amp;nbsp; &lt;font color="#d6b656"&gt;&lt;b&gt;▮&lt;/b&gt;&lt;/font&gt; thanh ghi pipeline' style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="790" width="1100" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="3. UART và SPI master"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="840" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Cấu trúc bên trong hai ngoại vi truyền thông (rtl/periph/uart, rtl/periph/spi)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1200" height="34" as="geometry"/></mxCell><mxCell id="n2" value="uart_apb – UART (APB slot 0, 0x1000_0000)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=2;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;swimlaneFillColor=#FCFCFC;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="1090" hei