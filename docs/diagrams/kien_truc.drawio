<mxfile host="drawio" version="24.7.17"><diagram id="p1" name="1. SoC soc_top"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Kiến trúc SoC &lt;i&gt;soc_top&lt;/i&gt; – lõi RISC-V RV32IMC, bus Wishbone B4 / APB4, ngoại vi UART và SPI" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1300" height="34" as="geometry"/></mxCell><mxCell id="n2" value="soc_top (rtl/soc_top.sv)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;arcSize=2;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=13;swimlaneFillColor=#FCFCFC;" vertex="1" parent="1"><mxGeometry x="120" y="60" width="1100" height="780" as="geometry"/></mxCell><mxCell id="n3" value='&lt;b&gt;rst_sync&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;bật bất đồng bộ, nhả đồng bộ 2 FF&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;" vertex="1" parent="n2"><mxGeometry x="30" y="50" width="200" height="55" as="geometry"/></mxCell><mxCell id="n4" value='&lt;b&gt;rv_core&lt;/b&gt;&lt;br&gt;RV32IMC + Zicsr + Zifencei + Zicntr&lt;br&gt;Pipeline 5 tầng IF → ID → EX → MEM → WB&lt;br&gt;Forwarding, phát hiện hazard&lt;br&gt;Dự đoán rẽ nhánh: BHT 256 + BTB 32&lt;br&gt;(BP_MODE 0 / 1 / 2)&lt;br&gt;Ngoại lệ chính xác, ngắt Machine mode&lt;br&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;&lt;i&gt;CORE_SC = 1 → rv_core_sc (single-cycle, tham chiếu)&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;fontSize=12;" vertex="1" parent="n2"><mxGeometry x="30" y="160" width="260" height="300" as="geometry"/></mxCell><mxCell id="n5" value='&lt;b&gt;ram_dp&lt;/b&gt;&lt;br&gt;128 KB, 2 cổng&lt;br&gt;0x8000_0000 – 0x8001_FFFF&lt;br&gt;&lt;font style="font-size:10px"&gt;cổng A: lệnh · cổng B: dữ liệu&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;" vertex="1" parent="n2"><mxGeometry x="420" y="90" width="210" height="130" as="geometry"/></mxCell><mxCell id="n6" value='&lt;b&gt;dbus_xbar&lt;/b&gt;&lt;br&gt;giải mã địa chỉ&lt;br&gt;&lt;font style="font-size:10px"&gt;ngoài vùng → ERR (access fault)&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;" vertex="1" parent="n2"><mxGeometry x="420" y="270" width="210" height="90" as="geometry"/></mxCell><mxCell id="n7" value='&lt;b&gt;apb_bridge&lt;/b&gt;&lt;br&gt;Wishbone B4 → APB4&lt;br&gt;&lt;font style="font-size:10px"&gt;IDLE → SETUP → ACCESS · slot = addr[15:12]&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;" vertex="1" parent="n2"><mxGeometry x="420" y="440" width="210" height="90" as="geometry"/></mxCell><mxCell id="n8" value="APB4 &amp;nbsp;(PSEL[15:0], PADDR, PWDATA, PRDATA, PREADY, PSLVERR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;horizontal=0;fontStyle=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="n2"><mxGeometry x="700" y="50" width="28" height="640" as="geometry"/></mxCell><mxCell id="n9" value='&lt;b&gt;UART&lt;/b&gt; · slot 0 · 0x1000_0000&lt;br&gt;&lt;font style="font-size:10px"&gt;FIFO TX/RX 16 byte, 8 bit + parity tùy chọn + 1/2 stop&lt;br&gt;BAUD_DIV, ngắt TX_WM / RX_WM / ERR&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;" vertex="1" parent="n2"><mxGeometry x="770" y="50" width="230" height="86" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;exitX=1.0000;exitY=0.0672;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value='&lt;b&gt;SPI master&lt;/b&gt; · slot 1 · 0x1000_1000&lt;br&gt;&lt;font style="font-size:10px"&gt;FIFO TX/RX 16 byte, mode 0–3 (CPOL, CPHA)&lt;br&gt;CLK_DIV, CS_N[3:0], ngắt TX_EMPTY / RX / DONE&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;" vertex="1" parent="n2"><mxGeometry x="770" y="155" width="230" height="86" as="geometry"/></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;exitX=1.0000;exitY=0.2313;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n13" value='&lt;b&gt;GPIO&lt;/b&gt; · slot 3 · 0x1000_3000&lt;br&gt;&lt;font style="font-size:10px"&gt;16 chân, thanh ghi DIR, đồng bộ 2 FF&lt;br&gt;ngắt theo cạnh lên / xuống&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;" vertex="1" parent="n2"><mxGeometry x="770" y="260" width="230" height="86" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;exitX=1.0000;exitY=0.3953;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n15" value='&lt;b&gt;SIM_CTRL&lt;/b&gt; · slot 15 · 0x1000_F000&lt;br&gt;&lt;font style="font-size:10px"&gt;PUTCHAR, EXIT&lt;br&gt;&lt;i&gt;chỉ dùng khi mô phỏng&lt;/i&gt;&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;verticalAlign=middle;dashed=1;" vertex="1" parent="n2"><mxGeometry x="770" y="365" width="230" height="86" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;exitX=1.0000;exitY=0.5594;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value='&lt;b&gt;INTC&lt;/b&gt; · slot 4 · 0x1000_4000&lt;br&gt;&lt;font style="font-size:10px"&gt;PENDING / ENABLE / ACTIVE&lt;br&gt;gom 3 nguồn ngắt → meip&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;" vertex="1" parent="n2"><mxGeometry x="770" y="470" width="230" height="86" as="geometry"/></mxCell><mxCell id="n18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;exitX=1.0000;exitY=0.7234;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value='&lt;b&gt;TIMER64&lt;/b&gt; · slot 2 · 0x1000_2000&lt;br&gt;&lt;font style="font-size:10px"&gt;mtime / mtimecmp 64 bit, PRESCALE&lt;br&gt;→ mtip, msip, mtime&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;" vertex="1" parent="n2"><mxGeometry x="770" y="575" width="230" height="86" as="geometry"/></mxCell><mxCell id="n20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;exitX=1.0000;exitY=0.8875;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="clk&lt;br&gt;rst_n" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffffff;strokeColor=#666666;fontSize=12;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="80" height="55" as="geometry"/></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="n21" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="rst_sn → mọi khối" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.3846;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="ibus (Wishbone B4)&lt;br&gt;chỉ đọc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;jumpStyle=arc;jumpSize=8;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=3;exitX=1.0000;exitY=0.1167;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.8077;entry